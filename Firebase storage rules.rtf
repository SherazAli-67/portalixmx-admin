\f0\fs24 \cf0 rules_version = '2';\
service firebase.storage \{\
  match /b/\{bucket\}/o \{\
\
    // --- Helper functions ---\
    function isSignedIn() \{\
      return request.auth != null;\
    \}\
\
    function isAdmin() \{\
      return isSignedIn() &&\
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";\
    \}\
\
    function isSubAdmin() \{\
      return isSignedIn() &&\
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "SUB_ADMIN";\
    \}\
\
    function isSeller() \{\
      return isSignedIn() &&\
             exists(/databases/(default)/documents/sellers/$(request.auth.uid));\
    \}\
    \
    // ------------------------------\
    // VIDEO ADS (Sub-Admin & Admin)\
    // ------------------------------\
    match /video_ads/\{fileName\} \{\
      // Allow Sub-Admins to upload and read video ads\
      allow read, write: if isSubAdmin();\
      \
      // Allow admins full access\
      allow read, write: if isAdmin();\
    \}\
\
    // ------------------------------\
    // SELLER IMAGES (Cover & Logo)\
    // ------------------------------\
    match /sellers/\{sellerId\}/\{imageFile\} \{\
      // Allow authenticated users to upload their own seller images (for registration)\
      // This works even before the seller document exists\
      allow read, write: if \
        isSignedIn() && request.auth.uid == sellerId;\
  \
      // Allow admin full access\
      allow read, write: if isAdmin();\
      \
      // Allow Sub-Admins to read seller images\
      allow read: if isSubAdmin();\
      \
      // Allow sellers to manage their own images (once seller document exists)\
      allow read, write: if isSeller() && request.auth.uid == sellerId;\
    \}\
\
    // ------------------------------\
    // SELLER VIDEOS\
    // ------------------------------\
    match /videos/\{sellerId\}/\{fileName\} \{\
      // Allow seller to manage their own files\
      allow read, write: if\
        isSignedIn() && request.auth.uid == sellerId;\
\
      // Allow admin full access\
      allow read, write: if isAdmin();\
      \
      // Allow Sub-Admins to read seller videos\
      allow read: if isSubAdmin();\
    \}\
\
    // ------------------------------\
    // SELLER THUMBNAILS\
    // ------------------------------\
    match /thumbnails/\{sellerId\}/\{thumbFile\} \{\
      // Seller can upload or view their own thumbnails\
      allow read, write: if\
        isSignedIn() && request.auth.uid == sellerId;\
\
      // Admin can manage all thumbnails\
      allow read, write: if isAdmin();\
      \
      // Allow Sub-Admins to read thumbnails\
      allow read: if isSubAdmin();\
    \}\
\
    // ------------------------------\
    // ADMIN VIDEOS\
    // ------------------------------\
    match /admin_videos/\{adminId\}/\{videoFile\} \{\
      // Only admins can upload or view admin videos\
      allow read, write: if isAdmin();\
      \
      // Allow Sub-Admins to read admin videos\
      allow read: if isSubAdmin();\
    \}\
\
    // ------------------------------\
    // REWARD IMAGES (NEW)\
    // ------------------------------\
    match /reward_images/\{rewardId\}/\{imageFile\} \{\
      // Everyone can read reward images\
      allow read: if isSignedIn();\
      \
      // Only admins can upload reward images\
      allow write: if isAdmin();\
    \}\
\
    // ------------------------------\
    // USER PROFILE IMAGES\
    // ------------------------------\
    match /profile_images/\{userId\}/\{imageFile\} \{\
      // Users can read and write their own profile images\
      allow read, write: if isSignedIn() && request.auth.uid == userId;\
      \
      // Admins can manage all profile images\
      allow read, write: if isAdmin();\
      \
      // Allow Sub-Admins to read profile images\
      allow read: if isSubAdmin();\
    \}\
\
    // ------------------------------\
    // DENY EVERYTHING ELSE\
    // ------------------------------\
    match /\{allPaths=**\} \{\
      allow read, write: if false;\
    \}\
  \}\
\}\
\
}